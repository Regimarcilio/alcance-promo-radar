# ==========================================================================
# promo-radar-novo — variáveis de ambiente
# Copie para `.env` (NUNCA commite o .env) e preencha.
#   cp .env.example .env && chmod 600 .env
# ==========================================================================

# ---------- Geral ----------
# Modo de operação do app: manual | piloto | auto (default: manual)
MODO=manual
# Interface em que o processo escuta.
# - execução local: 127.0.0.1 (não expõe na LAN)
# - dentro do container o compose força 0.0.0.0; quem controla a exposição é MANAGER_BIND
HOST=127.0.0.1
# Interface do HOST publicada pelo Docker Compose (default: 127.0.0.1).
# Use 0.0.0.0 SOMENTE com TLS/reverse proxy na frente (LAN/WAN).
MANAGER_BIND=127.0.0.1
# Nível do log estruturado (pino): trace|debug|info|warn|error|fatal (default: info).
LOG_LEVEL=info
# Porta interna do gerenciador web (default: 8091; no Docker publicada em
# ${MANAGER_BIND}:${MANAGER_PORT}, por padrão 127.0.0.1:8091).
MANAGER_PORT=8091
# Credencial machine opcional para /api/* (header X-Manager-Key).
# O painel em si é protegido por sessão; vazio = só sessão.
MANAGER_KEY=
# Tag da imagem construída pelo compose (default: local).
MANAGER_IMAGE_TAG=local
# Porta do manager-novo (docker-compose.manager-novo.yml); sempre em loopback.
MANAGER_PORT_NOVO=8099

# Token opcional do tools/qr-server.mjs (o servidor só escuta em 127.0.0.1).
# Quando definido, a página e a rota /qr exigem ?token=... na URL.
QR_TOKEN=
QR_PORT=8097

# ---------- Mercado Livre (afiliado) ----------
# Sua etiqueta de afiliado ML (usada para reescrever os links)
TAG_ML=
# Cookie de sessão do portal de afiliados (segredo — nunca volta pela API)
COOKIE_ML=
# API key do Mercado Livre (opcional, para vitrine/preços)
ML_API_KEY=
# Conversor/curto de link do ML (opcional)
ML_CONVERSOR_URL=

# ---------- Evolution API (WhatsApp) ----------
# Motor: v2 (default) ou go
EVO_ENGINE=v2
# --- v2 ---
# Porta publicada no host (Docker) — o compose publica apenas em 127.0.0.1.
EVO_HOST_PORT=8082
EVO_URL=http://localhost:8082
# OBRIGATÓRIA. Também é o AUTHENTICATION_API_KEY da Evolution no compose.
EVO_KEY=
# Bootstrap: nome criado no primeiro boot. Depois que houver números no painel,
# a fonte da verdade é o "principal" em data/instancias.json (não fixe aqui).
EVO_INSTANCE=radar-piloto
# --- Postgres da Evolution v2 (obrigatório no compose) ---
# Use senha forte; se houver @ : / ? # na senha, URL-encode na URI do compose.
EVO_DB_USER=radar
EVO_DB_PASS=
EVO_DB_NAME=evolution
# --- go ---
EVO_GO_URL=http://localhost:8081
# OBRIGATÓRIAS no docker-compose.go.yml.
EVO_GO_KEY=
EVO_GO_DB_USER=postgres
EVO_GO_DB_PASS=
EVO_GO_AUTH_DB=evogo_auth
EVO_GO_USERS_DB=evogo_users
EVO_GO_HOST_PORT=8081
EVO_GO_SEND_PATH=/send/text

# ---------- Mensagens (RN-001) ----------
# Marca no topo das mensagens (ex.: "@meucanal")
MARCA_HANDLE=
# Nome da marca (ex.: "Meu Radar")
MARCA_NOME=

# ---------- Janela de envio / anti-ban ----------
JANELA_INICIO=08:00
JANELA_FIM=23:00
# Horas de quarentena por conta após bloqueio/erro (default: 24)
QUARENTENA_H=
# Aprovar ofertas automaticamente sem revisão? (true/false)
AUTO_APROVADO=false
# Apenas testes: força a hora (ex.: "14:30") para simular a janela
HORA_OVERRIDE=
# Grupo único usado em testes
GRUPO_TESTE=

# ==========================================================================
# MODO MONITOR (E6 / RF-030–035)
# ==========================================================================
# Chave exigida no header X-Webhook-Key no POST /api/webhook/evolution.
# Configure a MESMA chave no webhook da Evolution API. Obrigatória (mínimo 16 chars);
# o manager não sobe sem ela.
WEBHOOK_KEY=
# URL pública do webhook usada ao registrar/verificar na Evolution.
# Default no container: http://promo_radar_manager:8091/api/webhook/evolution
WEBHOOK_URL=

# Grupos monitorados (origem) e seus destinos podem ser definidos por env:
#   MONITOR_GRUPOS  = JIDs de origem, separados por vírgula (máx. 10)
#   MONITOR_DESTINOS = JIDs de destino, separados por vírgula (máx. 10)
# Observação: a interface web (aba 📡 Monitor) tem prioridade quando preenchida.
MONITOR_GRUPOS=
MONITOR_DESTINOS=

# --- Etiquetas/refs dos programas (troca de link de afiliado / RF-032) ---
# Amazon Associates tag (ex.: meucanal-20)
AMAZON_TAG=
# Amazon Creators API (substitui a PA-API 5.0; requer >= 10 vendas qualificadas
# nos últimos 30 dias + aceitação final; crie em: Portal de Associados →
# Ferramentas → Creators API). Opcional: sem isso, Amazon sai sem foto/título.
AMAZON_CREATORS_ID=
AMAZON_CREATORS_SECRET=
# Versão da credencial (define o endpoint de token): 3.1 NA (BR) · 3.2 EU · 3.3 FE
# AMAZON_CREATORS_VERSION=3.1
# Marketplace da API (padrão: www.amazon.com.br)
# AMAZON_MARKETPLACE=www.amazon.com.br
# Shopee Affiliate Open API (generateShortLink). Solicite App ID/Secret em
# affiliate.shopee.com.br/open_api. Sem credenciais, links Shopee vão p/ revisão.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Sub IDs de rastreio (até 5, separados por vírgula) — aparecem em utm_content
SHOPEE_SUB_IDS=
# Legado: aplica só `smtt` (rastreio do app, NÃO gera comissão). Mantido para
# compatibilidade; o link continua indo para revisão.
SHOPEE_SUBID=

# Mercado Livre: access token OAuth da conta de afiliado.
# Necessario para favoritar itens automaticamente (POST /users/me/bookmarks).
# Sem o token, o modulo de favoritos fica INERTE.
ML_ACCESS_TOKEN=
# KaBuM ref (parâmetro de indicação)
KABUM_REF=

# Autenticação do painel — gere com: openssl rand -hex 32
SESSION_SECRET=
AUTH_TTL_HORAS=8
AUTH_IDLE_MIN=30
# 1 (default seguro) = cookie de sessão só via HTTPS. Mantenha 1 em produção.
# Use 0 SOMENTE para desenvolvimento em http://127.0.0.1 sem proxy TLS.
AUTH_COOKIE_SECURE=1
# 1 somente se houver reverse proxy confiável na frente (usa X-Forwarded-For).
# Deixe 0 se o manager estiver exposto diretamente.
TRUST_PROXY=0

# ---------- TLS / reverse proxy (produção) ----------
# O manager fala HTTP em loopback. Para acesso remoto, termine TLS (1.2+) em
# Caddy/nginx/Traefik e encaminhe para 127.0.0.1:8091. Requisitos:
#   - certificado válido (Let's Encrypt) e HSTS no proxy;
#   - AUTH_COOKIE_SECURE=1 e TRUST_PROXY=1 apenas se o proxy for confiável;
#   - nunca publique 0.0.0.0:8091 direto sem TLS;
#   - webhooks da Evolution devem usar HTTPS quando saírem da máquina.

# ---------- Filas e diagnóstico ----------
# Intervalo (s) entre liberações da fila anti-rajada do monitor (atual: 60; default: 120)
MONITOR_FILA_INTERVALO_S=60
# Intervalo (s) entre disparos da fila de clientes (default: 60)
CLIENTES_INTERVALO_S=60
# Limite de eventos guardados no estado do monitor (padrão: 500).
# 0 = ilimitado (o contador "recebidas" não trava; o arquivo cresce).
MONITOR_EVENTOS_LIMITE=500
# Sync diário da lista de grupos ativos (Evolution). 0 desliga.
MONITOR_SYNC_GRUPOS=1
# Hora local (TZ America/Sao_Paulo) da execução diária.
MONITOR_SYNC_GRUPOS_HORA=6
# 1 = adiciona automaticamente grupos novos como origens (usa o destino padrão).
# 0 = apenas atualiza nomes/lista; o operador adiciona manualmente.
MONITOR_AUTO_ORIGENS=1
# Ritmo do sync de contatos: pausa entre grupos (padrão: 4000ms) e espera quando
# o WhatsApp limita (padrão: 45000ms). Sem pausa, o sync estoura o rate limit
# (429 rate-overlimit) e volta sem capturar contatos.
SYNC_PAUSA_MS=8000
SYNC_BACKOFF_MS=90000
# Piloto: retomar os loops automaticamente após reinício do container.
# 0 (padrão) = pausa tudo por segurança (clique em START no painel).
# 1 = religa os loops que estavam rodando (útil quando o deploy reinicia o container).
PILOTO_AUTORELIGA=0
# Volume do monitor (dedup): janela em dias (padrão 7) e escopo.
# DEDUP_POR_ORIGEM=1 → o mesmo produto vindo de grupos DIFERENTES é
# reencaminhado (cada origem publica 1 vez) = muito mais volume no destino.
# DEDUP_DIAS menor → repassa o mesmo produto mais rápido.
DEDUP_DIAS=7
DEDUP_POR_ORIGEM=0

# Adição de contatos ao grupo (WhatsApp limita adições em rajada):
# um por vez, com pausa entre eles, e espera maior quando vier rate-overlimit.
GRUPO_ADICIONAR_PAUSA_MS=3000
GRUPO_ADICIONAR_ESPERA_MS=45000
GRUPO_ADICIONAR_TENTATIVAS=3

# Rotação de números: chance (0..1) de não repetir o número do envio anterior
# (padrão 0.7). 1 = nunca repete em sequência; 0 = sorteio puro por peso.
RODIZIO_EVITA_REPETICAO=0.7
# 1 = grava resumo de cada webhook em data/debug-webhook.log (evite em produção)
MONITOR_DEBUG=0
# 1 = processa o monitor sem enviar nada (dry-run global)
MONITOR_DRY=0

# ==========================================================================
# BACKUP / DR (scripts/backup.sh e scripts/restore.sh)
# ==========================================================================
# Destino dos pacotes. Default: $HOME/backups/alcance-promo-radar
# BACKUP_DIR=
# Retenção em dias (0 desativa a limpeza automática). Default: 14
BACKUP_RETENTION_DAYS=14
# Cifra do backup:
#   auto    = age se BACKUP_AGE_RECIPIENT + binário age existirem; senão openssl
#   age     = recomendado (chave assimétrica/age)
#   openssl = AES-256-CTR + HMAC-SHA256 (encrypt-then-MAC)
BACKUP_ENCRYPTION=auto
# Senha do modo openssl. NUNCA commite; prefira um arquivo 600 fora do repo:
#   BACKUP_PASSPHRASE_FILE="$HOME/.config/alcance-backup.pass"
# (o script não lê este .env; exporte a variável no shell/cron)
BACKUP_PASSPHRASE_FILE=
BACKUP_PASSPHRASE=
# age: chave pública (age1...) para criptografar e arquivo da identidade para
# restaurar (ex.: ~/.config/age/keys.txt). Guarde a identidade FORA do servidor.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
# pg_dump via docker: auto (se o container existir), 1 (obrigatório) ou 0.
BACKUP_PG=auto
PG_CONTAINER=evolution_pg_radar
PG_ADMIN_USER=postgres
# Restauração do dump: auto (se houver dump e container), 1 (obrigatório) ou 0.
# ATENÇÃO: sobrescreve o banco de destino.
RESTORE_PG=auto
